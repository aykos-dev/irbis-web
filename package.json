{
  "name": "irbis-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start --port 3001",
    "lint": "eslint . --quiet",
    "typecheck": "next typegen > /dev/null && tsc --noEmit --pretty false",
    "test": "vitest run",
    "test:ci": "vitest run --reporter=dot --silent",
    "slop": "! grep -rnE 'TODO|FIXME|@ts-ignore|@ts-expect-error|eslint-disable|\\bmock' src --include='*.ts' --include='*.tsx' --exclude-dir=__tests__ --exclude='*.spec.*' --exclude='*.test.*' --exclude-dir=generated && ! grep -rnE '(-|[[:space:]\"`])\\[(#|[0-9])' src --include='*.tsx' --include='*.ts' --exclude-dir=generated",
    "check": "npm run -s lint && npm run -s typecheck && npm run -s test:ci && npm run -s slop",
    "gen:api": "orval"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.3",
    "@tanstack/react-table": "9.3.1",
    "axios": "1.20.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.0",
    "lucide-react": "1.58.0",
    "next": "16.4.2",
    "next-intl": "4.14.9",
    "radix-ui": "1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.90.0",
    "sonner": "2.0.8",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.14.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "eslint-plugin-boundaries": "7.2.0",
    "jsdom": "30.1.3",
    "msw": "3.0.3",
    "orval": "8.43.0",
    "shadcn": "4.22.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
